// A6.com.tr — Production schema
// Domain models grow phase-by-phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lightweight schema version marker for connectivity / ops checks.
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schema_meta")
}

// ---------------------------------------------------------------------------
// Authentication (FAZ 1)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String?
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  memberships Membership[]

  @@index([email])
  @@map("users")
}

/// One-time password challenge. Code is stored hashed, never plaintext.
model OtpChallenge {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  requestIp   String?
  userAgent   String?

  @@index([email, createdAt])
  @@index([email, consumedAt])
  @@map("otp_challenges")
}

/// Server-side session. Cookie holds opaque token; DB stores hash for revoke.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Multi-tenant core (FAZ 2)
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CompanyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  companies   Company[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model Company {
  id                  String        @id @default(cuid())
  organizationId      String
  name                String
  legalName           String?
  slug                String        @unique
  shortDescription    String?
  about               String?
  sector              String?
  foundedYear         Int?
  logoUrl             String?
  coverUrl            String?
  website             String?
  primaryEmail        String?
  primaryPhone        String?
  whatsappPhone       String?
  taxOffice           String?
  taxNumber           String?
  mersisNumber        String?
  tradeRegistryNumber String?
  status              CompanyStatus @default(DRAFT)
  publishedAt         DateTime?
  /// Field-level visibility (expanded in company builder phase)
  taxNumberVisible    Boolean       @default(false)
  mersisVisible       Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([slug])
  @@map("companies")
}
