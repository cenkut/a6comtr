# =============================================================================
# A6.com.tr — Environment Variables (EXAMPLE ONLY)
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=A6
APP_URL=http://localhost:3000
APP_DOMAIN=localhost

# Database (PostgreSQL)
DATABASE_URL=postgresql://a6:a6_dev_password@localhost:5433/a6?schema=public

# Session / Auth
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=10

# Mail (console | smtp)
MAIL_PROVIDER=console
MAIL_FROM="A6 <noreply@a6.com.tr>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# File uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Platform admin (comma-separated emails)
PLATFORM_ADMIN_EMAILS=

# Feature flags
SEED_ON_BOOT=false
